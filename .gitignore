# NOTE: web/lib/api-types.ts is generated by `npm run gen:api` but IS committed --
# the web build imports it, so CI must not need a running API to typecheck.
# Run artifacts: large, regenerable, superseded by the next run.
# Both forms are needed -- `results*.json` does not match `results/x.json`,
# which is how ~3MB of traces got committed once already.
results*.json
results/
.DS_Store
