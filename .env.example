# ---- Provider API keys (standard LiteLLM names) ----
# Only the providers you actually run need a key; /api/models flags missing ones.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=

# ---- Infrastructure ----
POSTGRES_USER=evalharness
POSTGRES_PASSWORD=evalharness
POSTGRES_DB=evalharness
DATABASE_URL=postgresql+asyncpg://evalharness:evalharness@postgres:5432/evalharness
REDIS_URL=redis://redis:6379/0

# ---- Harness settings ----
# EVALHARNESS_SCENARIOS_DIR and EVALHARNESS_MODELS_FILE are deliberately NOT set
# here. They default to ./scenarios and ./config/models.yaml relative to the repo
# root, which is what the CLI needs; docker-compose sets the container paths on
# the api and worker services itself. Setting them here would point a local
# `evalharness validate` at a path that only exists inside a container.
# Max concurrent model calls per provider, to respect rate limits (SPEC 9.1).
EVALHARNESS_PROVIDER_CONCURRENCY=4
# LLM-judge assertions are non-deterministic and off unless explicitly enabled.
EVALHARNESS_ENABLE_JUDGE=false
LOG_LEVEL=INFO

# ---- Published host ports ----
# Only these are published; the services talk to each other over the compose
# network regardless. Override any that collide with something already running
# (another stack's Postgres or Redis is the usual culprit).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# ---- Frontend ----
# Browser-visible; must be reachable from the host, not just the compose network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
